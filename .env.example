# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# PostgreSQL - account-service
ACCOUNT_DB_HOST=localhost
ACCOUNT_DB_PORT=5442
ACCOUNT_DB_NAME=account_db
ACCOUNT_DB_USER=account
ACCOUNT_DB_PASSWORD=account

# PostgreSQL - transfer-service
TRANSFER_DB_HOST=localhost
TRANSFER_DB_PORT=5443
TRANSFER_DB_NAME=transfer_db
TRANSFER_DB_USER=transfer
TRANSFER_DB_PASSWORD=transfer

# PostgreSQL - antifraud-service
ANTIFRAUD_DB_HOST=localhost
ANTIFRAUD_DB_PORT=5434
ANTIFRAUD_DB_NAME=antifraud_db
ANTIFRAUD_DB_USER=antifraud
ANTIFRAUD_DB_PASSWORD=antifraud

# PostgreSQL - notification-service
NOTIFICATION_DB_HOST=localhost
NOTIFICATION_DB_PORT=5435
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=notification

# Redis (usado por account-service/transfer-service para cache, idempotencia/lock da saga,
# rate limiting e blacklist de logout do JWT)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (compartilhado entre account-service, que emite o token no login, e transfer-service, que
# só valida a assinatura) — troque por um valor gerado aleatoriamente antes de qualquer deploy
# real, isto aqui é só o default de desenvolvimento local.
JWT_SECRET=banco-digital-saga-jwt-secret-desenvolvimento-nao-usar-em-producao
JWT_EXPIRATION_MINUTES=15

# OpenTelemetry / Jaeger
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Anthropic API (uso futuro no notification-service)
ANTHROPIC_API_KEY=

# Z-API (uso futuro no notification-service, envio via WhatsApp)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
